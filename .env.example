# =============================================================================
# 环境区分
#   APP_ENV=local  → 加载 .env + .env.local   （Windows 本地/测试）
#   APP_ENV=prod   → 加载 .env + .env.prod    （Linux 正式）
#
# 建议拆分：
#   .env           → 公共项（表名、流程参数、开关默认值）
#   .env.local     → 测试：MySQL / Redis / LLM / Embedding / Arango
#   .env.prod      → 生产：同上（见 .env.local / .env.prod）
# =============================================================================
APP_ENV=local

# ---------- ArangoDB（集合名等公共项；连接账号建议放 .env.local / .env.prod）----------
ARANGO_HOSTS=http://127.0.0.1:8529
ARANGO_USER=root
ARANGO_PASSWORD=changeme
ARANGO_DB=metadata_graph

# 两个实体表（vertex collection）
ARANGO_TABLE_COLLECTION=table
ARANGO_FIELD_COLLECTION=field

# 三张关系表（edge collection）
ARANGO_TABLE_CONTAIN_FIELD=table_contain_field
ARANGO_TABLE_BUILD_TABLE=table_build_table
ARANGO_FIELD_BUILD_FIELD=field_build_field

# 实体上英文名/标识字段的属性名——按你实际的 schema 改（假设是 name，见 README）
ENTITY_NAME_ATTR=name
# 中文名属性
ENTITY_NAME_CN_ATTR=name_cn

# ---------- Redis / Embedding / LLM ----------
# 以下仅为占位；测试/生产请分别写在 .env.local、.env.prod 并覆盖
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_RESULT_KEY_PREFIX=meta-completion:
REDIS_RECORD_KEY_PREFIX=metadata-completion:insert-sql
REDIS_JOIN_KEY_PREFIX=metadata-completion:sql-join

EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_API_KEY=sk-xxx
EMBEDDING_MODEL=text-embedding-3-small

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=500

# ---------- 流程参数 ----------
# 图谱溯源最大跳数（跨 table_contain_field / table_build_table / field_build_field 任意方向）
MAX_TRACE_DEPTH=3
# 向量匹配阶段，图谱邻域内最多取多少个候选字段做向量化（控制成本）
MAX_VECTOR_CANDIDATES=20
SIMILARITY_THRESHOLD=0.7
# 流水线默认并发度（请求体 concurrency 可动态覆盖，范围 1~64）
PIPELINE_CONCURRENCY=3
# 分析层表过滤（仅拉取缺失中文名时生效；按表英文名 name 锚定正则匹配，不过滤 schema）
# 分析层（默认启用）: dws_/ads_/dwm_/fct_/dim_
# 共享层（默认关闭，需要时把下面两项追加进 ANALYSIS_LAYER_PREFIXES）:
#   dwd_
#   un[0-9]+_   （un + 数字 + _，如 un1_/un23_；勿用 \d，易被转义）
# 完整示例（分析层+共享层）:
# ANALYSIS_LAYER_PREFIXES=dws_,ads_,dwm_,fct_,dim_,dwd_,un[0-9]+_
TABLE_SCHEMA_ATTR=schema
TABLE_OBJECT_KEY_ATTR=object_key
FIELD_TABLE_ID_ATTR=table_id
ANALYSIS_LAYER_PREFIXES=dws_,ads_,dwm_,fct_,dim_
ANALYSIS_LAYER_FILTER_ENABLED=true

# ---------- 每日定时补全 ----------
# Asia/Shanghai 时区每天凌晨 02:00 执行，与 POST /metadata/completion/ 使用同一流水线
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=Asia/Shanghai
SCHEDULER_HOUR=2
SCHEDULER_MINUTE=0
SCHEDULER_PAGE_SIZE=50
# 多进程/多副本去重锁，按自然日生成 Redis key
SCHEDULER_LOCK_KEY_PREFIX=meta-completion:scheduler:
SCHEDULER_LOCK_TTL_SECONDS=172800

# ---------- 定时检测新 SQL（血缘 + 表关联）----------
# 按整点对齐，默认每 3 小时（0/3/6/9/12/15/18/21）扫描 insert_sql_source
# Redis 已打标的跳过；仅对新 SQL 跑血缘解析与 JOIN 提取
SQL_SCHEDULER_ENABLED=true
SQL_SCHEDULER_INTERVAL_HOURS=3
SQL_SCHEDULER_PAGE_SIZE=100
SQL_SCHEDULER_LOCK_KEY_PREFIX=meta-completion:sql-scheduler:
SQL_SCHEDULER_LOCK_TTL_SECONDS=10800

# ArangoDB 查询超时重试次数（首次失败后最多再重试 3 次）
ARANGO_MAX_RETRIES=3
ARANGO_RETRY_BASE_DELAY=0.5

# ---------- MySQL：INSERT SQL 源表 ----------
# 连接账号建议放 .env.local / .env.prod；此处仅公共表名/列名
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=metadata
# 源表及列名（库内原生表，只读：不自动建表、不改结构）
MYSQL_SQL_SOURCE_TABLE=workspace_task_sql_record_temp
MYSQL_COL_SQL=active_sql_text
MYSQL_COL_WORKSPACE_NAME=workspace_name
# 仅处理这些工作空间（英文逗号分隔，空=不过滤）；定时任务与批量解析都生效
MYSQL_WORKSPACE_FILTER=面向基层数据服务,数据一张图,元数据补全
# 血缘/关联结果表（不存在则自动创建）
MYSQL_TABLE_LINEAGE_TABLE=insert_table_lineage
MYSQL_FIELD_LINEAGE_TABLE=insert_field_lineage
MYSQL_FIELD_META_TABLE=insert_field_meta
# 表关联（JOIN）落库表
MYSQL_TABLE_JOIN_TABLE=insert_table_join
MYSQL_AUTO_CREATE_TABLES=true
# 中文名补全待办日表（字段/表扫描源，不从 ArangoDB 拉待办）
MYSQL_FIELDS_DAILY_TABLE=dim_prj_meta2_fields_daily
MYSQL_TABLES_DAILY_TABLE=dim_prj_meta2_tables_daily
MYSQL_TASK_TABLES_TABLE=insert_task_tables
